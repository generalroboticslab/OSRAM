<mujoco model="point_foot">
    <compiler angle="radian" meshdir="../meshes/" />
    <size njmax="500" nconmax="100" />

    <default>
        <light castshadow="false" diffuse="1 1 1" />
        <camera fovy="60"/>
        <default class="visual">
            <geom contype="0" conaffinity="0" group="1" type="mesh" rgba="0.9 0.9 0.9 1.0"/>
        </default>
        <!-- <joint armature="0.01" damping="0.01"/> -->
        <!-- <geom contype="1" conaffinity="1" condim="3" friction="0.6 0.005 0.0001" rgba="0.5 0.6 0.7 0.0" margin="0.001" group="0" /> -->
        <geom contype="1" conaffinity="1" condim="6" friction="1.0 0.005 0.0001" rgba="0.5 0.6 0.7 0.0" margin="0.001" group="0" solref="0.01 1" solimp="0.9 0.95 0.001" />
    </default>
    <visual>
        <rgba com="0.502 1.0 0 0.5" contactpoint="1.0 1.0 0.6 0.4" contactforce="0.2 0.98 0.2 0.8"/>
        <scale com="0.2" forcewidth="0.05" contactwidth="0.10" contactheight="0.04"/>
    </visual>

    <option timestep="0.001"/>

    <asset>
        <mesh name="base_Link" file="../meshes/point_foot/base_Link.STL" />
        <mesh name="abad_L_Link" file="../meshes/point_foot/abad_L_Link.STL" />
        <mesh name="hip_L_Link" file="../meshes/point_foot/hip_L_Link.STL" />
        <mesh name="knee_L_Link" file="../meshes/point_foot/knee_L_Link.STL" />
        <mesh name="foot_L_Link" file="../meshes/point_foot/foot_L_Link.STL" />
        <mesh name="abad_R_Link" file="../meshes/point_foot/abad_R_Link.STL" />
        <mesh name="hip_R_Link" file="../meshes/point_foot/hip_R_Link.STL" />
        <mesh name="knee_R_Link" file="../meshes/point_foot/knee_R_Link.STL" />
        <mesh name="foot_R_Link" file="../meshes/point_foot/foot_R_Link.STL" />
    </asset>

    <worldbody>
        <body name="base_Link" pos="0 0 0.82">
            <camera name="tracking" pos="0.846 -1.3 0.316" xyaxes="0.866 0.500 0.000 -0.171 0.296 0.940" mode="trackcom"/>
            <inertial pos="0.0457123 0.000139854 -0.163809" quat="0.972578 -0.00615364 -0.232461 0.00398682" mass="9.595" diaginertia="0.154712 0.11093 0.0846371" />
            <joint type="free" limited="false" damping="0.0000" stiffness="0.0000" armature="0"/>
            <site name="imu" pos="0 0 0"/>
            <geom class="visual" rgba="0.79216 0.81961 0.93333 1" mesh="base_Link" />
            <geom name="base_collision" size="0.135 0.13 0.095" pos="0.03 0 -0.072" type="box" rgba="0 0 1 0" />

            <body name="abad_L_Link" pos="0.05556 0.105 -0.2602">
                <inertial pos="-0.06977 0.04479 0.00057" quat="0.595024 0.579772 0.394141 0.393019" mass="1.469" diaginertia="0.00252289 0.00208104 0.00139163" />
                <joint name="abad_L_Joint" pos="0 0 0" axis="1 0 0" limited="true" range="-0.38397 1.39626" armature="0.000215"/>
                <geom class="visual" rgba="0.79216 0.81961 0.93333 1" mesh="abad_L_Link" />
                <geom name="abad_L_collision" type="cylinder" pos="-0.08 0 0" euler="1.57 0 0" size="0.05 0.025" rgba="0 0 1 0" />

                <body name="hip_L_Link" pos="-0.077 0.0205 0">
                    <inertial pos="-0.02869 -0.0477 -0.03992" quat="0.853885 0.192797 0.226903 0.426877" mass="2.3" diaginertia="0.0233264 0.0230229 0.00277548" />
                    <joint name="hip_L_Joint" pos="0 0 0" axis="0 1 0" limited="true" range="-1.01229 1.39626" armature="0.000215"/>
                    <geom class="visual" rgba="1 1 1 1" mesh="hip_L_Link" />
                    <geom name="hip_L_collision" type="cylinder" pos="-0.1 -0.02 -0.14" euler="0 0.53 0" size="0.035 0.09" rgba="0 0 1 0" />

                    <body name="knee_L_Link" pos="-0.15 -0.0205 -0.25981">
                        <inertial pos="0.05168 0.00152 -0.08148" quat="0.668191 -0.202995 -0.19946 0.687408" mass="0.55" diaginertia="0.00419956 0.00414131 0.000138393" />
                        <joint name="knee_L_Joint" pos="0 0 0" axis="0 -1 0" limited="true" range="-0.872665 1.36136" armature="0.000215"/>
                        <geom class="visual" rgba="0.79216 0.81961 0.93333 1" mesh="knee_L_Link" />
                        <geom name="knee_L_collision" type="cylinder" pos="0.078 0 -0.12" euler="0 -0.55 0" size="0.015 0.13" rgba ="0 0 1 0"/>

                        <geom class="visual" pos="0.150 0 -0.2598" rgba="0.26667 0.26667 0.26667 1" mesh="foot_L_Link" />
                        <geom name="foot_L_collision" type="sphere" pos="0.150 0 -0.2598" size="0.032" rgba="0 0 1 0" />
                        <site name="L_touch"  type="box" pos="0.150 0 -0.2598" size="0.097 0.037 0.01" rgba="0 1 0 0.3" />
                    </body>
                </body>
            </body>

            <body name="abad_R_Link" pos="0.05556 -0.105 -0.2602">
                <inertial pos="-0.06977 -0.04479 0.00057" quat="0.393019 0.394141 0.579772 0.595024" mass="1.469" diaginertia="0.00252289 0.00208104 0.00139163" />
                <joint name="abad_R_Joint" pos="0 0 0" axis="1 0 0" limited="true" range="-1.39626 0.38397" armature="0.000215"/>
                <geom class="visual" rgba="0.79216 0.81961 0.93333 1" mesh="abad_R_Link" />
                <geom name="abad_R_collision" type="cylinder" pos="-0.08 0 0" euler="1.57 0 0" size="0.05 0.025" rgba="0 0 1 0" />

                <body name="hip_R_Link" pos="-0.077 -0.0205 0">
                    <inertial pos="-0.02869 0.0477 -0.03992" quat="0.426877 0.226903 0.192797 0.853885" mass="2.3" diaginertia="0.0233264 0.0230229 0.00277548" />
                    <joint name="hip_R_Joint" pos="0 0 0" axis="0 -1 0" limited="true" range="-1.39626 1.01229" armature="0.000215"/>
                    <geom class="visual" rgba="1 1 1 1" mesh="hip_R_Link" />
                    <geom name="hip_R_collision" type="cylinder" pos="-0.10 0.025 -0.14" euler="0 0.53 0" size="0.035 0.09" rgba="0 0 1 0" />

                    <body name="knee_R_Link" pos="-0.15 0.0205 -0.25981">
                        <inertial pos="0.05168 -0.00152 -0.08148" quat="0.687408 -0.19946 -0.202995 0.668191" mass="0.55" diaginertia="0.00419956 0.00414131 0.000138393" />
                        <joint name="knee_R_Joint" pos="0 0 0" axis="0 1 0" limited="true" range="-1.36136 0.872665" armature="0.000215"/>
                        <geom class="visual" rgba="0.79216 0.81961 0.93333 1" mesh="knee_R_Link" />
                        <geom name="knee_R_collision" type="cylinder" pos="0.078 0 -0.12" euler="0 -0.55 0" size="0.015 0.13" rgba ="0 0 1 0"/>

                        <geom class="visual" pos="0.150 0 -0.2598" rgba="0.26667 0.26667 0.26667 1" mesh="foot_L_Link" />
                        <geom name="foot_R_collision" type="sphere" pos="0.150 0 -0.2598" size="0.032" rgba="0 0 1 0" />
                        <site name="R_touch"  type="box" pos="0.150 0 -0.2598" size="0.097 0.037 0.01" rgba="0 1 0 0.3" />
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="abad_L_Joint"  gear="1"  joint="abad_L_Joint" ctrllimited='true' ctrlrange='-80 80'/><!-- gear 18.6624.0-->
        <motor name="hip_L_Joint"   gear="1"  joint="hip_L_Joint"  ctrllimited='true' ctrlrange='-80 80'/>
        <motor name="knee_L_Joint"  gear="1"  joint="knee_L_Joint" ctrllimited='true' ctrlrange='-80 80'/>
        <motor name="abad_R_Joint"  gear="1"  joint="abad_R_Joint" ctrllimited='true' ctrlrange='-80 80' />
        <motor name="hip_R_Joint"   gear="1"  joint="hip_R_Joint"  ctrllimited='true' ctrlrange='-80 80' />
        <motor name="knee_R_Joint"  gear="1"  joint="knee_R_Joint" ctrllimited='true' ctrlrange='-80 80'/>
    </actuator>

    <sensor>
        <framequat name="imu_quat" objtype="site" objname="imu"/>
        <gyro name="imu_gyro" site="imu"/>
        <accelerometer name="imu_acc" site="imu"/>
        <jointpos name="abad_L_pos"    joint="abad_L_Joint" />
        <jointpos name="hip_L_pos"     joint="hip_L_Joint" />
        <jointpos name="knee_L_pos"    joint="knee_L_Joint" />
        <jointpos name="abad_R_pos"    joint="abad_R_Joint" />
        <jointpos name="hip_R_pos"     joint="hip_R_Joint" />
        <jointpos name="knee_R_pos"    joint="knee_R_Joint" />

        <jointvel name="abad_L_vel"    joint="abad_L_Joint" />
        <jointvel name="hip_L_vel"     joint="hip_L_Joint" />
        <jointvel name="knee_L_vel"    joint="knee_L_Joint" />
        <jointvel name="abad_R_vel"    joint="abad_R_Joint" />
        <jointvel name="hip_R_vel"     joint="hip_R_Joint" />
        <jointvel name="knee_R_vel"    joint="knee_R_Joint" />

        <jointactuatorfrc name="abad_L_tau"    joint="abad_L_Joint" />
        <jointactuatorfrc name="hip_L_tau"     joint="hip_L_Joint" />
        <jointactuatorfrc name="knee_L_tau"    joint="knee_L_Joint" />
        <jointactuatorfrc name="abad_R_tau"    joint="abad_R_Joint" />
        <jointactuatorfrc name="hip_R_tau"     joint="hip_R_Joint" />
        <jointactuatorfrc name="knee_R_tau"    joint="knee_R_Joint" />

        <touch name="L_contact_sensor" site="L_touch" />
        <touch name="R_contact_sensor" site="R_touch" />

        <!-- Ground Truth -->
        <framepos name="frame_pos" objtype="site" objname="imu" />
        <framequat name="frame_quat" objtype="site" objname="imu" />
        <framelinvel name="frame_linvel" objtype= "site" objname="imu"/>
        <frameangvel name="frame_angvel" objtype= "site" objname="imu"/>
        <framelinacc name="frame_linacc" objtype= "site" objname="imu"/>
        <frameangacc name="frame_angacc" objtype= "site" objname="imu"/>

        <!--keep the relative order between these four sensors-->
        <force name="L_grf" site="L_touch"/>
        <force name="R_grf" site="R_touch"/>
        <framequat name="L_foot_quat" objname="L_touch" objtype="site"/>
        <framequat name="R_foot_quat" objname="R_touch" objtype="site"/>
    </sensor>

    <keyframe>
        <key name="home" qpos="0 0 0.55
                                  1 0 0 0
                                  0 0.58 1.35
                                  0 -0.58 -1.35"/>

    </keyframe>
</mujoco>
